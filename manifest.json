{
  "manifest_version": 2,
  "name": "Qbit Sender",
  "version": "1.9.0",
  "description": "Send torrent and magnet links to qBittorrent, choosing the category for every add. Fork of Send to qBittorrent by frogmech.",
  "author": "https://github.com/Arrdee81",
  "browser_specific_settings": {
    "gecko": {
      "id": "qbit-sender@arrdee81",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    }
  },
  "permissions": [
    "contextMenus",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
    "matches": ["<all_urls>"],
    "js": ["leftclicksend.js"],
    "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "config.html"
  }
}
